{% extends 'base.html.twig' %}

{% block title %}Créer un collaborateur{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Créer un collaborateur</h1>
        <p>
            Créez le profil OnboardHub d’un collaborateur.
            Le compte Keycloak doit utiliser le même email.
        </p>
    </section>

    <article class="card">
        {{ form_start(form) }}
            <div class="form-grid">
                {{ form_row(form.firstName) }}
                {{ form_row(form.lastName) }}
                {{ form_row(form.email) }}
                {{ form_row(form.hiredAt) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="primary-action compact-action">
                    Créer le collaborateur
                </button>

                <a href="{{ path('app_dashboard') }}" class="secondary-action">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </article>
{% endblock %}