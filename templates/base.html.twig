<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}OnboardHub{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    </head>
    <body>
        <header class="site-header">
            <div class="container header-inner">
                <a href="{{ path('app_dashboard') }}" class="brand">OnboardHub</a>

                <nav class="main-nav" aria-label="Navigation principale">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}">Dashboard</a>

                        {% if is_granted('ROLE_MANAGER') or is_granted('ROLE_HR') or is_granted('ROLE_ADMIN') %}
                            <span class="nav-badge">Pilotage</span>
                        {% endif %}

                        <span class="nav-user">
                            {{ app.user.fullName }}
							<small>
								{{ app.user.roles|join(', ') }}
							</small>
                        </span>

                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="container page-content">
			{% for message in app.flashes('success') %}
				<div class="alert-success">
					{{ message }}
				</div>
			{% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>