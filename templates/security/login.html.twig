{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Connexion à OnboardHub</h1>
        <p>Utilise un compte de test pour le MVP.</p>
    </section>

    <article class="card" style="max-width: 520px;">
        {% if error %}
            <div class="alert-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div>
                <label for="email">Email</label><br>
                <input
                    type="email"
                    id="email"
                    name="email"
                    value="{{ last_username }}"
                    required
                    autofocus
                    style="width: 100%; margin-top: 0.35rem; padding: 0.7rem;"
                >
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div style="margin-top: 1rem;">
                <button type="submit">Se connecter</button>
            </div>
        </form>

        <hr style="margin: 1.25rem 0;">

        <p><strong>Comptes de test</strong></p>
        <ul class="simple-list">
            <li>collab@onboardhub.local</li>
            <li>manager@onboardhub.local</li>
            <li>rh@onboardhub.local</li>
        </ul>
    </article>
{% endblock %}
