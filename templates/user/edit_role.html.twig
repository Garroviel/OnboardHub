{% extends 'base.html.twig' %}

{% block title %}Modifier le rôle{% endblock %}

{% block body %}
    <h1>Modifier le rôle</h1>

    <p>
        {{ user.firstName }} {{ user.lastName }}
        — {{ user.email }}
    </p>

    {{ form_start(form) }}
        {{ form_row(form.role) }}

        <button type="submit">
            Enregistrer
        </button>
    {{ form_end(form) }}
{% endblock %}