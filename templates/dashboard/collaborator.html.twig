{% extends 'base.html.twig' %}

{% block title %}Dashboard collaborateur{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Bonjour {{ user.fullName }}</h1>
        <p>Bienvenue sur votre espace d’onboarding.</p>
    </section>

    <section class="grid">
        <article class="card">
            <h2>Mon onboarding</h2>

            {% if onboarding %}
                <dl class="details-list">
                    <div>
                        <dt>Statut</dt>
                        <dd>{{ onboarding.status.value }}</dd>
                    </div>
                    <div>
                        <dt>Progression</dt>
                        <dd>{{ onboarding.progressPercent }}%</dd>
                    </div>
                    <div>
                        <dt>Date de début</dt>
                        <dd>{{ onboarding.startDate|date('d/m/Y') }}</dd>
                    </div>
                    <div>
                        <dt>Date cible</dt>
                        <dd>
                            {% if onboarding.dueDate %}
                                {{ onboarding.dueDate|date('d/m/Y') }}
                            {% else %}
                                —
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            {% else %}
                <p>Aucun onboarding n’est encore associé à votre compte.</p>
            {% endif %}
        </article>

        <article class="card">
            <h2>Veille tech</h2>

            {% if latestArticles is not empty %}
                <ul class="simple-list">
                    {% for article in latestArticles %}
                        <li>
                            <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">
                                {{ article.title }}
                            </a>
                            <small>
                                {{ article.source }}
                                {% if article.score is not null %}· score {{ article.score }}{% endif %}
                            </small>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>Aucun article en cache pour le moment.</p>
            {% endif %}
        </article>
    </section>

    {% if onboarding %}
        <section class="stack">
            <article class="card">
                <h2>Tâches</h2>

                {% if onboarding.tasks is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Priorité</th>
                                <th>Date limite</th>
                                <th>Assignée par</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for task in onboarding.tasks %}
                                <tr>
                                    <td>{{ task.title }}</td>
									<td>
										<form method="post" action="{{ path('app_onboarding_task_update_status', {id: task.id}) }}">
											<select name="status">
												<option value="TODO" {% if task.status.value == 'TODO' %}selected{% endif %}>TODO</option>
												<option value="IN_PROGRESS" {% if task.status.value == 'IN_PROGRESS' %}selected{% endif %}>IN_PROGRESS</option>
												<option value="DONE" {% if task.status.value == 'DONE' %}selected{% endif %}>DONE</option>
											</select>
											<button type="submit">Mettre à jour</button>
										</form>
									</td>
                                    <td>{{ task.priority }}</td>
                                    <td>
                                        {% if task.dueDate %}
                                            {{ task.dueDate|date('d/m/Y') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.assignedBy %}
                                            {{ task.assignedBy.fullName }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucune tâche prévue.</p>
                {% endif %}
            </article>

            <article class="card">
                <h2>Formations</h2>

                {% if onboarding.trainings is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Lien</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for training in onboarding.trainings %}
                                <tr>
                                    <td>{{ training.title }}</td>
                                    <td>{{ training.status.value }}</td>
                                    <td>
                                        {% if training.url %}
                                            <a href="{{ training.url }}" target="_blank" rel="noopener noreferrer">
                                                Ouvrir
                                            </a>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucune formation prévue.</p>
                {% endif %}
            </article>

            <article class="card">
                <h2>Logiciels</h2>

                {% if onboarding.softwareItems is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Statut</th>
                                <th>Lien d’installation</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for software in onboarding.softwareItems %}
                                <tr>
                                    <td>{{ software.name }}</td>
                                    <td>
										<form method="post" action="{{ path('app_onboarding_software_update_status', {id: software.id}) }}">
											<select name="status">
												<option value="TODO" {% if software.status.value == 'TODO' %}selected{% endif %}>TODO</option>
												<option value="DONE" {% if software.status.value == 'DONE' %}selected{% endif %}>DONE</option>
											</select>
											<button type="submit">Mettre à jour</button>
										</form>
									</td>
                                    <td>
                                        {% if software.installUrl %}
                                            <a href="{{ software.installUrl }}" target="_blank" rel="noopener noreferrer">
                                                Installer
                                            </a>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucun logiciel prévu.</p>
                {% endif %}
            </article>
        </section>
    {% endif %}
{% endblock %}