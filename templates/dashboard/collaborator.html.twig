{% extends 'base.html.twig' %}

{% block title %}Dashboard collaborateur{% endblock %}

{% block body %}
    <section class="page-header">
        <h1>Bonjour {{ user.fullName }}</h1>
        <p>Bienvenue sur votre espace d’onboarding.</p>
    </section>

    <section class="grid">
        <article class="card">
            <h2>Mon onboarding</h2>

            {% if onboarding %}
                <div class="stats-grid">
					<div class="stat-card">
						<span class="stat-label">Statut</span>
						<strong class="stat-value">{{ onboarding.status.value }}</strong>
					</div>

					<div class="stat-card stat-card-progress">
						<span class="stat-label">Progression</span>
						<strong class="progress-value">{{ onboarding.progressPercent }}%</strong>
						<div class="progress-track" aria-label="Progression onboarding">
							<div class="progress-bar" style="width: {{ onboarding.progressPercent }}%;"></div>
						</div>
					</div>

					<div class="stat-card">
						<span class="stat-label">Date de début</span>
						<strong class="stat-value">{{ onboarding.startDate|date('d/m/Y') }}</strong>
					</div>

					<div class="stat-card">
						<span class="stat-label">Date cible</span>
						<strong class="stat-value">
							{% if onboarding.dueDate %}
								{{ onboarding.dueDate|date('d/m/Y') }}
							{% else %}
								—
							{% endif %}
						</strong>
					</div>
				</div>
            {% else %}
                <p>Aucun onboarding n’est encore associé à votre compte.</p>
            {% endif %}
        </article>

        <article class="card" id="watch">
            <h2>Veille tech</h2>

            {% if latestArticles is not empty %}
                <ul class="simple-list">
                    {% for article in latestArticles %}
                        <li>
                            <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">
                                {{ article.title }}
                            </a>
                            <small>
                                {{ article.source }}
                                {% if article.score is not null %}· score {{ article.score }}{% endif %}
                            </small>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p>Aucun article en cache pour le moment.</p>
            {% endif %}
        </article>
    </section>

    {% if onboarding %}
        <section class="stack">
            <article class="card" id="tasks">
                <h2>Tâches</h2>

                {% if onboarding.tasks is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Priorité</th>
                                <th>Date limite</th>
                                <th>Assignée par</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for task in onboarding.tasks %}
                                <tr>
                                    <td>
										<strong>{{ task.title }}</strong>
										{% include 'onboarding/_comments.html.twig' with {
											item: task,
											route: 'app_onboarding_task_comment'
										} %}
									</td>
									<td>
										<form method="post" action="{{ path('app_onboarding_task_update_status', {id: task.id}) }}">
											<select name="status">
												<option value="TODO" {% if task.status.value == 'TODO' %}selected{% endif %}>TODO</option>
												<option value="IN_PROGRESS" {% if task.status.value == 'IN_PROGRESS' %}selected{% endif %}>IN_PROGRESS</option>
												<option value="DONE" {% if task.status.value == 'DONE' %}selected{% endif %}>DONE</option>
											</select>
											<button type="submit">Mettre à jour</button>
										</form>
									</td>
                                    <td>{{ task.priority }}</td>
                                    <td>
                                        {% if task.dueDate %}
                                            {{ task.dueDate|date('d/m/Y') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if task.assignedBy %}
                                            {{ task.assignedBy.fullName }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucune tâche prévue.</p>
                {% endif %}
            </article>

            <article class="card" id="trainings">
                <h2>Formations</h2>

                {% if onboarding.trainings is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Lien</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for training in onboarding.trainings %}
                                <tr>
                                    <td>
										<strong>{{ training.title }}</strong>
										{% include 'onboarding/_comments.html.twig' with {
											item: training,
											route: 'app_onboarding_training_comment'
										} %}
									</td>
									<td>
										<form method="post" action="{{ path('app_onboarding_training_update_status', {id: training.id}) }}">
											<select name="status">
												<option value="TODO" {% if training.status.value == 'TODO' %}selected{% endif %}>TODO</option>
												<option value="IN_PROGRESS" {% if training.status.value == 'IN_PROGRESS' %}selected{% endif %}>IN_PROGRESS</option>
												<option value="DONE" {% if training.status.value == 'DONE' %}selected{% endif %}>DONE</option>
											</select>
											<button type="submit">Mettre à jour</button>
										</form>
									</td>
                                    <td>
                                        {% if training.url %}
                                            <a href="{{ training.url }}" target="_blank" rel="noopener noreferrer">
                                                Ouvrir
                                            </a>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucune formation prévue.</p>
                {% endif %}
            </article>

            <article class="card" id="software">
                <h2>Logiciels</h2>

                {% if onboarding.softwareItems is not empty %}
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Statut</th>
                                <th>Lien d’installation</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for software in onboarding.softwareItems %}
                                <tr>
                                    <td>
										<strong>{{ software.name }}</strong>
										{% include 'onboarding/_comments.html.twig' with {
											item: software,
											route: 'app_onboarding_software_comment'
										} %}
									</td>
                                    <td>
										<form method="post" action="{{ path('app_onboarding_software_update_status', {id: software.id}) }}">
											<select name="status">
												<option value="TODO" {% if software.status.value == 'TODO' %}selected{% endif %}>TODO</option>
												<option value="DONE" {% if software.status.value == 'DONE' %}selected{% endif %}>DONE</option>
											</select>
											<button type="submit">Mettre à jour</button>
										</form>
									</td>
                                    <td>
                                        {% if software.installUrl %}
                                            <a href="{{ software.installUrl }}" target="_blank" rel="noopener noreferrer">
                                                Installer
                                            </a>
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>Aucun logiciel prévu.</p>
                {% endif %}
            </article>
        </section>
    {% endif %}
{% endblock %}